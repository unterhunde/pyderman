  "interfaces": [
    {
      "name": "Audio UDP",
      "caller": "UDPMicStreamer",
      "receiver": "AudioReceiverService",
      "protocol": "UDP",
      "format": "AUDIO_HEADER + int16 PCM",
      "timeout": "0.5s socket timeout on receiver",
      "recovery": "drop on full queue; manual reconnect"
    },
    {
      "name": "Video UDP",
      "caller": "UDPVideoStreamer",
      "receiver": "UDPVideoReceiver",
      "protocol": "UDP",
      "format": "CHUNK_HEADER + JPEG chunks",
      "timeout": "15ms GUI poll + 0.2s worker gets",
      "recovery": "buffer pruning; manual reconnect"
    },
    {
      "name": "Heartbeat UDP",
      "caller": "UDPVideoStreamer",
      "receiver": "UDPVideoReceiver",
      "protocol": "UDP",
      "format": "HEARTBEAT_PACKET",
      "timeout": "500ms send interval",
      "recovery": "UI offline after ~2s without heartbeat"
    },
    {
      "name": "Ollama HTTP",
      "caller": "OllamaService",
      "receiver": "Ollama server",
      "protocol": "HTTP POST",
      "format": "{model,prompt,stream:true}",
      "timeout": "120s request timeout",
      "recovery": "log error and append fallback text"
    },
    {
      "name": "SSH control",
      "caller": "PiStreamerManager",
      "receiver": "Pi SSH daemon",
      "protocol": "SSH",
      "format": "shell command string",
      "timeout": "8s connect timeout; 12/20s command timeouts",
      "recovery": "return ssh-failed/failed; no retry"
    },
    {
      "name": "Whisper in-process API",
      "caller": "WhisperService",
      "receiver": "openai-whisper",
      "protocol": "Python API",
      "format": "float32 audio array",
      "timeout": "worker loop timeout 0.2s on queue",
      "recovery": "log exception; return empty transcript"
    },
    {
      "name": "YOLO in-process API",
      "caller": "InferenceEngine",
      "receiver": "ultralytics.YOLO",
      "protocol": "Python API",
      "format": "RGB/ BGR frame arrays",
      "timeout": "worker queue timeout 0.2s",
      "recovery": "surface error status"
    },
    {
      "name": "Camera API",
      "caller": "frame_source.open_camera",
      "receiver": "Picamera2",
      "protocol": "Python API",
      "format": "RGB frames",
      "timeout": "none",
      "recovery": "synthetic frame fallback"
    },
    {
      "name": "Logging queue",
      "caller": "GuiLogHandler",
      "receiver": "OperatorConsoleApp._drain_log_queue",
      "protocol": "in-process queue",
      "format": "formatted strings",
      "timeout": "80ms timer",
      "recovery": "drop on queue full"
    }
