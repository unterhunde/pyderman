  "threads": [
    {
      "name": "Tk main thread",
      "owner": "pc/client.py",
      "purpose": "GUI event loop",
      "sync": "Tk event loop"
    },
    {
      "name": "AudioReceiverService thread",
      "owner": "pc/services/audio_receiver.py",
      "purpose": "UDP audio receive",
      "sync": "stop_event + queue"
    },
    {
      "name": "WhisperService thread",
      "owner": "pc/services/whisper_service.py",
      "purpose": "Speech segmentation/transcription",
      "sync": "stop_event + RuntimeConfig lock + queues"
    },
    {
      "name": "OllamaService thread",
      "owner": "pc/services/ollama_service.py",
      "purpose": "Streaming response worker",
      "sync": "stop_event + queue"
    },
    {
      "name": "UDPVideoReceiver poll timer",
      "owner": "pc/video/receiver_widget.py",
      "purpose": "poll UDP socket",
      "sync": "Tk.after"
    },
    {
      "name": "UDPVideoReceiver render worker",
      "owner": "pc/video/receiver_widget.py",
      "purpose": "decode/inference/render frames",
      "sync": "render queue + inference lock + stop event"
    },
    {
      "name": "GUI drain timers",
      "owner": "pc/operator_console_app.py",
      "purpose": "drain UI and log queues and refresh status",
      "sync": "Tk.after"
    },
    {
      "name": "Startup checks thread",
      "owner": "pc/operator_console_app.py",
      "purpose": "validate model/UDP/Ollama",
      "sync": "_post_ui"
    },
    {
      "name": "Streamer status thread",
      "owner": "pc/operator_console_app.py",
      "purpose": "query Pi streamer status over SSH",
      "sync": "_post_ui"
    },
    {
      "name": "Streamer action thread",
      "owner": "pc/operator_console_app.py",
      "purpose": "start/stop Pi streamer over SSH",
      "sync": "_post_ui"
    },
    {
      "name": "ThreadMonitor monitor thread",
      "owner": "pc/services/thread_monitor.py",
      "purpose": "restart dead threads",
      "sync": "internal lock + stop event"
    }
  ],
